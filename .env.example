# Every key the configuration schema knows about. scripts/check-env-example.ts
# fails CI if this file and src/config.ts drift apart.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info
LOG_PRETTY=true

# mock needs no key and is what the tests and `npm run demo` use.
# openai talks to the real API; compatible talks to any OpenAI-shaped endpoint.
PROVIDER=mock
OPENAI_API_KEY=
OPENAI_BASE_URL=
MODEL=gpt-4o-mini
REQUEST_TIMEOUT_MS=30000
MAX_RETRIES=3

REDIS_URL=redis://127.0.0.1:6379/0

# Spending cap for the calendar month. Crossing it returns 429 with a
# Retry-After pointing at the start of the next month.
MONTHLY_BUDGET_USD=50
# closed refuses requests when the budget counter cannot be read; open lets
# them through.
BUDGET_FAIL_MODE=closed
RATE_LIMIT_PER_MINUTE=60

# exact matches identical prompts; semantic also matches near-identical ones;
# off disables the cache.
CACHE_MODE=exact
CACHE_TTL_SECONDS=3600
# Cosine similarity above which a semantic hit is accepted. Tuned to the
# embedder in use — this default suits a real embedding model, not the
# deterministic stand-in the tests and the demo run on.
SEMANTIC_THRESHOLD=0.95
